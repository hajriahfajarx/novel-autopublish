# Copy this to .env and fill in, or just run `npm run setup` and let the local
# settings UI fill this in for you (recommended).

# --- Gemini (Google AI Studio, new account) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# --- Google OAuth (Blogger + Sheets, new account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Blogger (new blog) ---
BLOG_ID=

# --- Google Sheets (2 tabs: Story + Characters) ---
SHEET_ID=

# --- Label applied to every post on Blogger ---
SERIES_LABEL=Cerita

# --- Scheduling ---
PUBLISH_TIMEZONE=Asia/Jakarta

# Set to "true" to save as a Blogger draft instead of actually publishing.
# Local-only, never a GitHub secret, so real scheduled runs always publish.
DRAFT_MODE=false

# Set to "true" to bypass the same-day dedup guard for manual re-testing.
# Local-only, never a GitHub secret.
FORCE_RUN=false
